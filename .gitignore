# Don't commit binary backgrounds
*.gif
*.png
*.jpg
*.jpeg
*.mp4
*.webm

# Allow screenshots used in the README
!docs/**/*.png
!docs/**/*.jpg

# Allow per-style bundled background images
!styles/**/background.gif
!styles/**/background.png
!styles/**/background.jpg
!styles/**/background.jpeg

# PowerShell profile backups created by install.ps1
*.bak-*

# OS/editor cruft
Thumbs.db
.DS_Store
.vscode/
.idea/
