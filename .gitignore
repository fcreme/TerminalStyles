# Don't commit binary backgrounds
*.gif
*.png
*.jpg
*.jpeg
*.mp4
*.webm

# Allow screenshots / demo videos used in the README
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.mp4

# Per-style background images are NOT committed to main.
# They live on the `gifs` branch and are lazy-fetched at runtime.
# (Previously these were committed via the four !styles/**/background.*
# exceptions; removed when the architecture moved to lazy-fetch.)

# Negative-cache markers written by Get-StyleBundledBackground on failed fetch
styles/**/.no-background

# PowerShell profile backups created by install.ps1
*.bak-*

# OS/editor cruft
Thumbs.db
.DS_Store
.vscode/
.idea/
